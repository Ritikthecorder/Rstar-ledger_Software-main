# ──────────────────────────────────────────────────────────
# LedgerPro — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# Never commit your real .env file to version control.
# ──────────────────────────────────────────────────────────

# Supabase — get these from your Supabase project:
#   https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ──────────────────────────────────────────────────────────
# The variables below are set automatically by Replit.
# When running locally or on Vercel you do NOT need to set
# them — sensible defaults are used automatically.
# ──────────────────────────────────────────────────────────

# PORT=5173        # dev server port (default: 5173)
# BASE_PATH=/      # URL base path   (default: /)
